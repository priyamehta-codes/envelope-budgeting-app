// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Envelope {
  id      String  @id @default(cuid())
  name    String
  balance Float   @default(0)
}

model Income {
  id      String  @id @default(cuid())
  amount  Float
  balance Float   @default(0)
}

